#!/usr/bin/env python3
"""Dispatch deterministic helpers and validate a static project declaration."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
SKILL_ROOT = PLUGIN_ROOT / "skills" / "workstream-ledger"
SCRIPTS = SKILL_ROOT / "scripts"
sys.path.insert(0, str(SCRIPTS))

from workstream_config import load_config, validate_config  # noqa: E402,F401


def fail(message: str) -> int:
    print(f"workstreamctl: {message}", file=sys.stderr)
    return 2


def usage() -> int:
    print(
        "usage: workstreamctl {plan|intake|resume|projection|repository-identity|repository-identity-seal|reconcile|shipyard-profile|ingress|tab-title|child-event|child-checkpoint} [args...]\n"
        "       workstreamctl linear inspect [--config PATH] [--team-id ID --project-id ID]\n"
        "       workstreamctl config validate [path]\n\n"
        "These commands expose existing deterministic helpers. They do not claim a hosted live-status service."
    )
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        return usage()
    command, *rest = argv
    scripts = {
        "plan": "workstream_plan.py",
        "intake": "workstream_intake.py",
        "resume": "workstream_resume.py",
        "projection": "workstream_projection.py",
        "repository-identity": "workstream_repository_identity.py",
        "repository-identity-seal": "workstream_repository_identity_seal.py",
        "reconcile": "workstream_reconcile.py",
        "shipyard-profile": "workstream_shipyard_profile.py",
        "ingress": "workstream_ingress.py",
        "tab-title": "workstream_tab.py",
        "child-event": "workstream_child_event.py",
        "child-checkpoint": "workstream_child_checkpoint.py",
    }
    if command in scripts:
        script = SCRIPTS / scripts[command]
        os.execv(sys.executable, [sys.executable, str(script), *rest])
        return 0
    if command == "linear" and rest[:1] == ["inspect"]:
        script = SCRIPTS / "workstream_linear_setup.py"
        os.execv(sys.executable, [sys.executable, str(script), *rest[1:]])
        return 0
    if command == "config" and rest[:1] == ["validate"]:
        if len(rest) > 2:
            return fail("config validate accepts at most one path")
        path = Path(rest[1]) if len(rest) == 2 else None
        try:
            loaded = load_config(path, required=True)
            assert loaded is not None
            value, resolved = loaded
        except ValueError as error:
            return fail(str(error))
        print(json.dumps({"valid": True, "path": str(resolved), "namespace": value["namespace"]}, sort_keys=True))
        return 0
    return fail(f"unknown command: {command}")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
