{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Generous-Corp/agent-workstream/blob/main/plugins/workstream/workstream.config.schema.json",
  "title": "Agent Workstream static project declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace", "ledger", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "namespace": {"type": "string", "pattern": "\\S"},
    "planning_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s/?#]+(?:[/?#][^\\s]*)?$"
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "workspace_id", "team_id", "project_id"],
      "properties": {
        "provider": {"type": "string", "pattern": "\\S"},
        "workspace_id": {"type": "string", "pattern": "\\S"},
        "team_id": {"type": "string", "pattern": "\\S"},
        "project_id": {"type": "string", "pattern": "\\S"}
      }
    },
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s:]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coordinate"],
        "properties": {
          "coordinate": {"type": "string", "pattern": "\\S"},
          "acceptance_commands": {
            "type": "array",
            "items": {"type": "string", "pattern": "\\S"}
          }
        }
      }
    }
  }
}
